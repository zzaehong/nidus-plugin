{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'nidus: 이 세션은 Nidus office 관리자다. office 스킬을 따른다. 시작하면 jobs.md의 반복 작업을 /loop로 다시 등록하고, 진행 중(접수/진행/검토)인 tasks/ 파일이 있으면 이어서 처리한다. Obsidian 볼트는 library 스킬로 읽기만 한다.'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|NotebookEdit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\""
          }
        ]
      }
    ]
  }
}
